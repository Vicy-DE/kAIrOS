# dev/rig/.env — host-side paths for the testrig (docker compose reads this file; the host
# helper scripts source it too). Copy to .env and edit; .env is gitignored.
# Every variable is optional: unset, it points into dev/rig/work/ (gitignored, created on demand).
# Paths are absolute, or relative to this directory.

# Where the appliance images live: kairos-hwtest-4070.img (gunzipped), the qcow2 overlays the VMs
# write to, testrig-console.log, and the .gpu.lock file (docs/how-to/VM-TEST-RIG.md). -> /images
KAIROS_HOME=./work

# Model files laid out like the manifests expect (llm/, image/, video/, music/, translation/, dict/).
# scripts/download-models.py fills it. Not needed by the test suite. -> /workspace/models
KAIROS_MODELS=./work/models

# The offline encyclopedia (wikipedia_en_all_mini_*.zim, ~12 GB) + Wiktionary ZIM add-ons. -> /workspace/knowledge
KAIROS_KNOWLEDGE=./work/knowledge

# kiwix-serve (scripts/download-knowledge.sh puts it here) + optionally engine binaries. Becomes the
# container's /opt/vibeos/bin, which tests/run-tests.sh probes for a real kiwix-serve. -> /workspace/bin
KAIROS_BIN=./work/bin

# A built engine set — the /opt/vibeos tree scripts/install-engines.sh produces (bin/ with ENGINES.json,
# engines/*/build, lib/). sync-guest.sh ships it into a booted guest. -> /workspace/engines
KAIROS_ENGINES=./work/engines

# The IOMMU group of the NVIDIA GPU (ls /dev/vfio/ after it is bound to vfio-pci); host-setup.sh
# writes the real number here. Only the `vm` service needs it.
VFIO_GROUP=14

# PCI addresses of the GPU's VGA and audio functions (lspci -nn | grep -i nvidia). Defaults are the
# reference laptop's; used by host-setup.sh, gpu-to-vfio.sh, gpu-to-host.sh and vm.sh.
#KAIROS_GPU_PCI=0000:01:00.0
#KAIROS_GPU_AUDIO_PCI=0000:01:00.1
#KAIROS_GPU_IDS=10de:2820,10de:22bd
