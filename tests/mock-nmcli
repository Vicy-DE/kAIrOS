#!/usr/bin/env python3
"""Mock nmcli [R38, R78] — a small STATEFUL NetworkManager for kernel/hw.py's tests.

State: JSON in $MOCK_NMCLI_STATE (default $VIBEOS_DIR/mock-nmcli.json), created from WORLD on
first use; a test writes its own world there. Honours the global options hw.py uses (-t, -e
yes|no, -f FIELDS, -g FIELDS, -s, --wait N) and nmcli's terse escaping (':' and '\\' inside a
value become '\\:' and '\\\\'), so SSIDs with colons / backslashes round-trip. Modelled
NetworkManager behaviour — what R78 has to cope with:
  * profiles {name, uuid, ssid, key_mgmt, psk, autoconnect, timestamp}: `dev wifi connect` makes
    one named after the SSID ("X 1", "X 2" when the name is taken) and KEEPS it when the join
    fails — the kernel has to delete it;
  * a join checks the AP's password; wrong or missing -> "Secrets were required, but not
    provided." rc 4; afterwards autoconnect brings the previous network back (unless the world
    says "no_autoreconnect": the kernel's own restore is tested then);
  * OWE-TM (Freifunk): no password, and once joined the in-use BSS is the hidden OWE twin that
    shows its own SSID; 802.1X cannot be joined with a password; an AP's "connectivity" (portal,
    limited) is the device's IP4-CONNECTIVITY;
  * "nm_running": false -> "Error: NetworkManager is not running." rc 8; "supplicant_starting"
    -> the device is "unavailable" while the radio is enabled; radio off or a wlan rfkill block
    in $VIBEOS_SYSFS -> "unavailable" + WIFI disabled; "old_nmcli" -> no IP4-CONNECTIVITY/CON-UUID
    fields (the kernel's fallback); "validate_psk" -> 8..63 characters like the real one.
Every call is appended to $MOCK_NMCLI_LOG (if set), one tab-separated argv per line."""
import fcntl
import json
import os
import sys
import time
import uuid as uuidlib
from pathlib import Path

STATE = Path(os.environ.get("MOCK_NMCLI_STATE")
             or Path(os.environ.get("VIBEOS_DIR", "/tmp/kairos-test")) / "mock-nmcli.json")
SYSFS = Path(os.environ.get("VIBEOS_SYSFS", "/sys"))
WORLD = {
