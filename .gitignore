# edit backups (house rule: <file>.bak-<date><tag> before every change) — never in git
*.bak
*.bak-*
*.bak[0-9]*

# Python
__pycache__/
*.pyc

# local engine build log
/engines-build.log

# dev/ scratch state (suite work dir, rig images/overlays/config, the rig's SSH key)
/dev/work/
/dev/rig/work/
/dev/rig/.env
/dev/rig/testrig/id_kairos
/dev/rig/testrig/id_kairos.pub
*.qcow2
