<?xml version="1.0" encoding="UTF-8"?>
<!-- kAIrOS kiosk openbox config [R28/R68]. openbox-session (.xinitrc) reads
     ~/.config/openbox/rc.xml before /etc/xdg/openbox/rc.xml; the Debian default gave
     every real X window (a generated pygame game) a 17-px Linux titlebar + border and
     a root menu on right-click (docs/DESKTOP-TECH-EVAL-2026-09.md §8.9, F10).
     Here: no decorations for any client, no root/desktop menu, no key bindings (no
     Alt-Tab popup, no run dialog, no Alt-drag of the kiosk window), click-to-focus,
     everything floating, one desktop. The kernel's window layer (kernel/wm.py) is what
     raises, minimizes and closes game windows — through EWMH, not through chrome.
     Derived from bench/proto/openbox-rc.xml (the measured configuration). -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse><raiseOnFocus>no</raiseOnFocus></focus>
  <placement><policy>Smart</policy><center>no</center></placement>
  <theme><titleLayout>N</titleLayout><keepBorder>no</keepBorder></theme>
  <desktops><number>1</number></desktops>
  <resize><drawContents>yes</drawContents><popupShow>Never</popupShow></resize>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>
  <keyboard></keyboard>
  <mouse>
    <dragThreshold>3</dragThreshold>
    <context name="Client"><mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind></context>
    <context name="Root"></context>
    <context name="Desktop"></context>
  </mouse>
  <menu></menu>
  <applications>
    <!-- every client: undecorated, focused when mapped, centred on the monitor that has the
         POINTER [R90] (a sign-in window, a game before the kernel puts it into its frame) —
         instead of top-left, or centred across ALL monitors (measured straddling the seam on
         2x1280). Not "active" (the focused window's monitor): with one desktop window over
         every monitor that is just the biggest monitor. NB openbox lets this position beat a
         position the program asks for (PPosition, what Chromium sets) — it is what put R52's
         two kiosks onto ONE monitor (docs/ONE-DESKTOP-2026-10-19.md) -->
    <application class="*"><decor>no</decor><focus>yes</focus>
      <position force="no"><x>center</x><y>center</y><monitor>mouse</monitor></position></application>
    <!-- [R90] the desktop: ONE Chromium window over every monitor (.xinitrc, WM_CLASS class
         kairos-desktop). At 0,0, undecorated, never fullscreen or maximized (either would
         shrink it to one monitor), in the NORMAL layer — above nothing: a game (transient for
         it, R82) and the sign-in window stay above it, a covered game can drop below it.
         scripts/desktop/kairos-desktop.py sizes it to the X screen. Last: per-app rules merge
         in order, so this one wins over "*" -->
    <application class="kairos-desktop"><decor>no</decor><focus>yes</focus><layer>normal</layer>
      <fullscreen>no</fullscreen><maximized>no</maximized><skip_taskbar>yes</skip_taskbar>
      <position force="yes"><x>0</x><y>0</y></position></application>
  </applications>
</openbox_config>
